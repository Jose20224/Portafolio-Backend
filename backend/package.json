{
  "name": "portafolio-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST del portafolio profesional con NestJS y Supabase",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@supabase/supabase-js": "2.119.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "prettier": "3.9.9",
    "typescript": "6.0.2"
  }
}
